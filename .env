# AskTheDB settings. Replace the placeholder values below with your own.
#
# Tip: to keep your real key out of Git, put it in a file named .env.local instead
# (same format, Git-ignored). Values in .env.local override the ones in this file.

# Alibaba Cloud Model Studio (DashScope) API key
QWEN_API_KEY=your-api-key-here

# OpenAI-compatible endpoint. Must match the region your key belongs to:
#   China (Beijing):         https://dashscope.aliyuncs.com/compatible-mode/v1
#   International (Singapore): https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Model used by the workflow
QWEN_MODEL=qwen-plus

# Optional: minimum log level (TRACE, DEBUG, INFO, SUCCESS, WARNING, ERROR, CRITICAL)
# LOG_LEVEL=INFO
